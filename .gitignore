# Rust
/target

# wasm-pack output (regenerated from the crate; never committed)
crates/*/pkg/
# the panic-probe package the wasm-exec gate builds (`just wasm-exec`)
crates/*/pkg-probe/

# web (React/Vite)
web/node_modules/
web/dist/

# Python (pipeline data-prep)
__pycache__/
.venv/

# macOS
.DS_Store
**/.DS_Store

# Agent worktrees created inside the repo — never committable.
# (A bare `git add -A` otherwise sweeps them in as embedded git repos.)
.claude/worktrees/
_site/
