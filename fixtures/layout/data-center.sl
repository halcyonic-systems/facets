system "Data Center"
component "Compute Racks"
component "Storage Array"
component "Network Fabric"
component "Utility Intake"
component "UPS Battery"
component "Power Distribution"
component "Chiller Plant"
component "Cooling Distribution"
component Orchestrator
component Monitoring
source Grid
source "Diesel Supply"
source "Water Utility"
source Tenants
source "Hardware Vendor"
sink Atmosphere
sink "Internet Peers"
sink "E-Waste Recycler"
sink Operators
flow Grid -> "Utility Intake" : energy "mains"
flow "Diesel Supply" -> "Utility Intake" : matter "fuel"
flow "Utility Intake" -> "UPS Battery" : energy "charge"
flow "Utility Intake" -> "Power Distribution" : energy "feed"
flow "UPS Battery" -> "Power Distribution" : energy "ride-through"
flow "Power Distribution" -> "Compute Racks" : energy "rack power"
flow "Power Distribution" -> "Storage Array" : energy "array power"
flow "Power Distribution" -> "Network Fabric" : energy "switch power"
flow "Power Distribution" -> "Chiller Plant" : energy "chiller power"
flow "Power Distribution" -> "Cooling Distribution" : energy "pump power"
flow "Water Utility" -> "Chiller Plant" : matter "makeup water"
flow "Chiller Plant" -> "Cooling Distribution" : matter "chilled water"
flow "Cooling Distribution" -> "Chiller Plant" : matter "return water"
flow "Cooling Distribution" -> "Compute Racks" : matter "cold air"
flow "Cooling Distribution" -> "Storage Array" : matter "cold air"
flow "Compute Racks" -> "Cooling Distribution" : energy "rack heat"
flow "Storage Array" -> "Cooling Distribution" : energy "array heat"
flow "Chiller Plant" -> Atmosphere : energy "rejected heat"
flow "Chiller Plant" -> Atmosphere : matter "evaporation"
flow Tenants -> "Network Fabric" : informational "requests"
flow "Network Fabric" -> "Compute Racks" : informational "jobs"
flow "Compute Racks" -> "Network Fabric" : informational "responses"
flow "Compute Racks" -> "Storage Array" : informational "writes"
flow "Storage Array" -> "Compute Racks" : informational "reads"
flow "Network Fabric" -> "Internet Peers" : informational "egress"
flow "Hardware Vendor" -> "Compute Racks" : matter "servers"
flow "Hardware Vendor" -> "Storage Array" : matter "drives"
flow "Compute Racks" -> "E-Waste Recycler" : matter "retired servers"
flow "Storage Array" -> "E-Waste Recycler" : matter "retired drives"
flow Orchestrator -> "Compute Racks" : informational "placement"
flow Orchestrator -> "Power Distribution" : informational "power caps"
flow Monitoring -> Orchestrator : informational "telemetry"
flow "Compute Racks" -> Monitoring : informational "metrics"
flow "Chiller Plant" -> Monitoring : informational "plant metrics"
flow Monitoring -> Operators : informational "alerts"
